{
  "name": "@dotrino/ia-agent",
  "version": "0.8.1",
  "description": "Agente de Dotrino IA: expone tus CLIs de IA (Claude, OpenCode) al chat remoto de ia.dotrino.com, vía @dotrino/remote-agent.",
  "type": "module",
  "bin": {
    "dotrino-ia-agent": "bin/cli.js"
  },
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "update.js",
    "init-podman.js",
    "init-docker.js",
    "bin",
    "drivers",
    "templates"
  ],
  "scripts": {
    "start": "node bin/cli.js run",
    "type-check": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@dotrino/identity": "0.105.0",
    "@dotrino/proxy-client": "0.25.0",
    "@dotrino/remote-agent": "0.13.0",
    "@dotrino/update": "0.5.1",
    "@dotrino/vault": "0.82.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imdotrino/dotrino-ia.git",
    "directory": "agent"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.9.3"
  }
}
