{
  "name": "Dotrino IA",
  "short_name": "IA",
  "description": "App retirada: usa Terminal (terminal.dotrino.com).",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f7fafc",
  "theme_color": "#00658c",
  "launch_handler": { "client_mode": "focus-existing" },
